# Copy this file to .env for local development only.
# .env is gitignored. NEVER commit real values.
# In production (Cloud Run) these are set as env vars / --set-secrets by scripts/deploy.ps1,
# not read from a .env file.

# ---- Server ----
PORT=8080
# Public URL this service is reachable at. Used to build the Google OAuth redirect URI
# and must exactly match a redirect URI registered on your Google OAuth client.
# Local dev example: http://localhost:8080
# Production example: https://multi-gmail-mcp-xxxxxxxxxx.a.run.app
PUBLIC_BASE_URL=http://localhost:8080

# ---- Google Cloud project (for Secret Manager) ----
GCP_PROJECT_ID=

# ---- Google OAuth client (created manually in Google Cloud Console) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Secrets that gate access to this server ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# In production these come from Secret Manager via --set-secrets, not from this file.
MCP_BEARER_TOKEN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
OAUTH_STATE_SECRET=

# ---- Account credential store ----
# "secret-manager" (default, required in production) or "file" (local dev only,
# stores accounts in .local/accounts.json which is gitignored). Never use "file" in production.
TOKEN_STORE=secret-manager
ACCOUNTS_SECRET_NAME=gmail-mcp-accounts

# ---- Feature flags ----
# Keep false unless you have deliberately added and reviewed write scopes/tools.
ENABLE_WRITE_TOOLS=false

# ---- Logging ----
# "info" (default, safe) or "debug" (adds timing/internal detail; still never logs
# tokens, email bodies, subjects, or sender/recipient addresses).
LOG_LEVEL=info
