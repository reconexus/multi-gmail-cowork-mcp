# Controls what gets uploaded to Cloud Build for `gcloud run deploy --source .`.
# Keeps the upload small and guarantees local secrets never leave this machine,
# even if a stray .env file exists locally.
.git/
.gitignore
.gcloudignore
node_modules/
dist/
.env
.env.*
.local/
credentials/
.secrets/
*.secret.json
token.json
**/token.json
service-account*.json
*-service-account*.json
client_secret*.json
*.pem
*.md
scripts/
